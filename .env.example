# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_GUILD_ID=your_guild_id_here_optional

# DM AI Configuration (DeepSeek by default)
DM_AI_ENDPOINT=https://api.deepseek.com
DM_AI_MODEL=deepseek-chat
DM_AI_API_KEY=your_deepseek_api_key_here

# TTS Configuration
# Option 1: Use Eleven Labs (recommended for better quality)
USE_ELEVEN=false
ELEVEN_LABS_KEY=your_eleven_labs_api_key_here
ELEVEN_LABS_DEFAULT_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVEN_LABS_MODEL_ID=eleven_multilingual_v2

# Option 2: Use OpenAI TTS (fallback when USE_ELEVEN=false)
TTS_AI_ENDPOINT=https://api.openai.com/v1
TTS_AI_MODEL=gpt-3.5-turbo
TTS_AI_API_KEY=your_openai_api_key_here

# OpenAI Configuration (fallback for TTS_AI_API_KEY if not set)
OPENAI_API_KEY=your_openai_api_key_here

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Bot Configuration
BOT_PREFIX=!
NODE_ENV=development

# Logging
LOG_LEVEL=info
